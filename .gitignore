.pytest_cache/
.mypy_cache/
.coverage
htmlcov/


# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example


# ---------- Windows ----------
Thumbs.db
Desktop.ini


# ---------- macOS ----------
.DS_Store
.venv_uv_backup/

# Python generated files
__pycache__/
*.pyc

# PAT runtime memory
data/memory.db
